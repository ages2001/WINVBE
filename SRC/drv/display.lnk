format windows dll
name winvbe.drv
option modname=DISPLAY
option description 'DISPLAY : 100, 96, 96 : WINVBE Universal VESA/VGA/SVGA'
option map=winvbe.map
option heapsize=1024
option nodefaultlibs
option quiet
libpath /opt/watcom/lib286/dos
library clibl.lib
segment type CODE PRELOAD FIXED
segment type DATA PRELOAD FIXED
import GETMODULEHANDLE KERNEL.47
import GETPROCADDRESS KERNEL.50
import GLOBALDOSALLOC KERNEL.184
import GETPRIVATEPROFILESTRING KERNEL.128
import GETPRIVATEPROFILEINT KERNEL.127
import FINDRESOURCE KERNEL.60
import LOADRESOURCE KERNEL.61
import LOCKRESOURCE KERNEL.62
export BITBLT.1
export COLORINFO.2
export CONTROL.3
export DISABLE.4
export ENABLE.5
export ENUMDFONTS.6
export ENUMOBJ.7
export OUTPUT.8
export PIXEL.9
export REALIZEOBJECT.10
export STRBLT.11
export SCANLR.12
export DEVICEMODE.13
export EXTTEXTOUT.14
export GETCHARWIDTH.15
export DEVICEBITMAP.16
export FASTBORDER.17
export SETATTRIBUTE.18
export DEVICEBITMAPBITS.19
export CREATEBITMAP.20
export DIBTODEVICE.21
export SETPALETTE.22
export GETPALETTE.23
export SETPALETTETRANSLATE.24
export GETPALETTETRANSLATE.25
export UPDATECOLORS.26
export STRETCHBLT.27
export INQUIRE.101
export SETCURSOR.102
export MOVECURSOR.103
export CHECKCURSOR.104
export USERREPAINTDISABLE.500
export STRETCHDIBITS.28
