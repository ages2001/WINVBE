format windows dll
name winvbe.drv
option modname=DISPLAY
option description 'DISPLAY : 100, 96, 96 : WINVBE Universal VESA/VGA/SVGA'
option map=winvbe.map
option heapsize=1024
option nodefaultlibs
option quiet
option packcode=0xC000
libpath /opt/watcom/lib286/dos
library clibl.lib
segment type CODE PRELOAD FIXED
segment type DATA PRELOAD FIXED
import GETMODULEHANDLE KERNEL.47
import GETPROCADDRESS KERNEL.50
import GLOBALDOSALLOC KERNEL.184
import GLOBALALLOC KERNEL.15
import GLOBALLOCK KERNEL.18
import GETPRIVATEPROFILESTRING KERNEL.128
import GETPRIVATEPROFILEINT KERNEL.127
import FINDRESOURCE KERNEL.60
import LOADRESOURCE KERNEL.61
import LOCKRESOURCE KERNEL.62
export BITBLT.1=W_BITBLT
export COLORINFO.2=W_COLORINFO
export CONTROL.3
export DISABLE.4
export ENABLE.5
export ENUMDFONTS.6=W_ENUMDFONTS
export ENUMOBJ.7=W_ENUMOBJ
export OUTPUT.8=W_OUTPUT
export PIXEL.9=W_PIXEL
export REALIZEOBJECT.10=W_REALIZEOBJECT
export STRBLT.11=W_STRBLT
export SCANLR.12=W_SCANLR
export DEVICEMODE.13=W_DEVICEMODE
export EXTTEXTOUT.14=W_EXTTEXTOUT
export GETCHARWIDTH.15=W_GETCHARWIDTH
export DEVICEBITMAP.16=W_DEVICEBITMAP
export FASTBORDER.17=W_FASTBORDER
export SETATTRIBUTE.18=W_SETATTRIBUTE
export DEVICEBITMAPBITS.19=W_DEVICEBITMAPBITS
export CREATEBITMAP.20=W_CREATEBITMAP
export DIBTODEVICE.21=W_DIBTODEVICE
export SETPALETTE.22
export GETPALETTE.23=W_GETPALETTE
export SETPALETTETRANSLATE.24=W_SETPALETTETRANSLATE
export GETPALETTETRANSLATE.25=W_GETPALETTETRANSLATE
export UPDATECOLORS.26=W_UPDATECOLORS
export STRETCHBLT.27=W_STRETCHBLT
export INQUIRE.101=W_INQUIRE
export SETCURSOR.102
export MOVECURSOR.103=W_MOVECURSOR
export CHECKCURSOR.104
export USERREPAINTDISABLE.500
export STRETCHDIBITS.28=W_STRETCHDIBITS
export VALIDATEMODE.700
export GAMMARAMP.32
export REENABLE.31
export SELECTBITMAP.29=W_SELECTBITMAP
export BITMAPBITS.30=W_BITMAPBITS
