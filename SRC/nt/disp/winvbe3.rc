/* WINVBE display driver for Windows NT 3.1 / 3.5 / 3.51 (user mode, CSRSS).
   NT 3.1 USER loads its OEM bitmaps, cursors, icons, default colours and the
   colour dialog table from the display driver: they are those of NT 3.1's
   own VGA.DLL (tools/stockres.py; WINVBE's artwork from tools/mkres.py when
   msfiles/stock is missing). RCDATA 1 starts with the OEM block NT 3.5+
   needs. */
#include <winver.h>
#include "nt3.rc"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DRV
FILESUBTYPE     VFT2_DRV_DISPLAY
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "WINVBE\0"
            VALUE "FileDescription",  "WINVBE VESA display driver\0"
            VALUE "FileVersion",      "1.1\0"
            VALUE "InternalName",     "winvbe.dll\0"
            VALUE "OriginalFilename", "winvbe.dll\0"
            VALUE "ProductName",      "WINVBE\0"
            VALUE "ProductVersion",   "1.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
