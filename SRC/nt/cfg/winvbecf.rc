#include <windows.h>
#include "cfgres.h"

IDI_APP ICON "../../cfg/winvbecf.ico"
IDI_UNINST ICON "../../cfg/winvbeun.ico"

IDD_MAIN DIALOG 8, 8, 292, 232
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "WINVBE Display Settings"
FONT 8, "MS Sans Serif"
BEGIN
    GROUPBOX        "Graphics adapter and monitor", -1, 6, 3, 280, 62
    LTEXT           "", IDC_INFO, 12, 13, 270, 49
    GROUPBOX        "Screen resolution", -1, 6, 68, 140, 112
    LISTBOX         IDC_MODES, 12, 80, 128, 94, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    GROUPBOX        "Options", -1, 152, 68, 134, 112
    LTEXT           "Colors:", -1, 158, 82, 40, 8
    COMBOBOX        IDC_DEPTH, 202, 80, 80, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Refresh:", -1, 158, 100, 40, 8
    COMBOBOX        IDC_REFRESH, 202, 98, 80, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Rates:", -1, 158, 118, 40, 8
    COMBOBOX        IDC_RATES, 202, 116, 80, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "8-bit DAC (256 colors)", IDC_DAC8, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 158, 134, 120, 10
    CONTROL         "Debug log (port E9h)", IDC_DEBUG, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 158, 146, 120, 10
    LTEXT           "915 patch:", IDC_PATCHLBL, 158, 162, 40, 8
    EDITTEXT        IDC_PATCH, 202, 160, 80, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "", IDC_CURRENT, 8, 186, 278, 9
    LTEXT           "", IDC_STATUS, 8, 197, 278, 9
    PUSHBUTTON      "&Install driver", IDC_INSTALL, 8, 212, 56, 14
    PUSHBUTTON      "&Mouse...", IDC_MOUSE, 67, 212, 42, 14
    PUSHBUTTON      "&Features...", IDC_FEATURES, 112, 212, 50, 14
    PUSHBUTTON      "&About", IDC_ABOUT, 165, 212, 36, 14
    DEFPUSHBUTTON   "OK", IDOK, 204, 212, 40, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 247, 212, 39, 14
END

IDD_ABOUT DIALOG 30, 24, 236, 120
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About WINVBE"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDI_APP, -1, 10, 10, 18, 20
    LTEXT           "WINVBE Universal VESA/VGA/SVGA Display Driver", -1, 40, 10, 190, 9
    LTEXT           "Version 1.2 for Windows NT", -1, 40, 21, 190, 9
    LTEXT           "Windows NT 3.1, 3.5, 3.51, 4.0, 2000, XP and Server 2003 (x86) and XP / Server 2003 x64.", -1, 40, 36, 190, 18
    LTEXT           "VBE 1.2 - 3.0 BIOSes with a linear frame buffer, 8/15/16/24/32 bits per pixel, EDID monitor detection, VBE 3.0 refresh rates and the Intel 915 video BIOS patch built into the miniport.", -1, 40, 56, 190, 36
    DEFPUSHBUTTON   "OK", IDOK, 93, 100, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,2,0,0
PRODUCTVERSION  1,2,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "WINVBE\0"
            VALUE "FileDescription",  "WINVBE display settings\0"
            VALUE "FileVersion",      "1.2\0"
            VALUE "InternalName",     "winvbecf\0"
            VALUE "OriginalFilename", "winvbecf.exe\0"
            VALUE "ProductName",      "WINVBE\0"
            VALUE "ProductVersion",   "1.2\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_MOUSE DIALOG 20, 16, 252, 172
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WINVBE Mouse"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Pointer speed:", -1, 8, 6, 74, 8
    LISTBOX         IDC_MSPEED, 8, 16, 74, 52, WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Double-click speed:", -1, 90, 6, 74, 8
    LISTBOX         IDC_MDBL, 90, 16, 74, 34, WS_BORDER | WS_TABSTOP
    LTEXT           "Pointer color:", -1, 172, 6, 74, 8
    LISTBOX         IDC_MCOLOR, 172, 16, 74, 76, WS_VSCROLL | WS_BORDER | WS_TABSTOP | WS_DISABLED
    CONTROL         "Swap left and right buttons", IDC_MSWAP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 78, 150, 10
    CONTROL         "Large pointer", IDC_MLARGE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP | WS_DISABLED, 8, 92, 150, 10
    LTEXT           "", IDC_MNOTE, 8, 112, 238, 28
    DEFPUSHBUTTON   "OK", IDOK, 140, 150, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 196, 150, 50, 14
END

IDD_FEATURES DIALOG 24, 20, 248, 206
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WINVBE Display Features"
FONT 8, "MS Sans Serif"
BEGIN
    GROUPBOX        "Screen", -1, 6, 3, 236, 62
    LTEXT           "Rotation:", -1, 12, 17, 70, 8
    COMBOBOX        IDC_FROT, 92, 15, 144, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Small modes:", -1, 12, 33, 70, 8
    COMBOBOX        IDC_FSCALE, 92, 31, 144, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Shadow buffer:", -1, 12, 49, 70, 8
    COMBOBOX        IDC_FSHADOW, 92, 47, 144, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Colour", -1, 6, 68, 236, 88
    LTEXT           "Gamma:", -1, 12, 82, 50, 8
    SCROLLBAR       IDC_FGAMMA, 64, 81, 140, 10, WS_TABSTOP
    LTEXT           "", IDC_FGAMMAV, 208, 82, 30, 8
    LTEXT           "Brightness:", -1, 12, 98, 50, 8
    SCROLLBAR       IDC_FBRIGHT, 64, 97, 140, 10, WS_TABSTOP
    LTEXT           "", IDC_FBRIGHTV, 208, 98, 30, 8
    LTEXT           "Contrast:", -1, 12, 114, 50, 8
    SCROLLBAR       IDC_FCONTR, 64, 113, 140, 10, WS_TABSTOP
    LTEXT           "", IDC_FCONTRV, 208, 114, 30, 8
    CONTROL         "", IDC_FPREVIEW, "Static", SS_OWNERDRAW, 12, 128, 224, 22
    LTEXT           "", IDC_FNOTE, 8, 160, 234, 26
    PUSHBUTTON      "&Defaults", IDC_FDEFAULT, 8, 188, 50, 14
    PUSHBUTTON      "&Apply", IDC_FAPPLY, 82, 188, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 136, 188, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 190, 188, 50, 14
END
