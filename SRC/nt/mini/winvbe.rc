/* WINVBE miniport (WINVBE.SYS): version information, shown by the Display
   Type dialog of Windows NT 3.5 / 3.51 / 4.0 */
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DRV
FILESUBTYPE     VFT2_DRV_DISPLAY
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "WINVBE\0"
            VALUE "FileDescription",  "WINVBE universal VESA video miniport\0"
            VALUE "FileVersion",      "1.1\0"
            VALUE "InternalName",     "winvbe.sys\0"
            VALUE "OriginalFilename", "winvbe.sys\0"
            VALUE "ProductName",      "WINVBE\0"
            VALUE "ProductVersion",   "1.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
