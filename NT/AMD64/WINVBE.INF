; WINVBE v1.3 - universal VESA/VGA/SVGA display driver
; Windows XP x64 / Server 2003 x64 (Plug and Play)
;
; Device Manager > Display adapters > (adapter) > Update Driver >
;   Install from a specific location > Don't search > Have Disk > this folder.

[Version]
Signature="$CHICAGO$"
Provider=%WVB%
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Class=Display
DriverVer=11/09/2026,1.3.0.0

[DestinationDirs]
DefaultDestDir   = 11
winvbe.Miniport  = 12
winvbe.Display   = 11
winvbe.Tools     = 11
winvbe.OpenGL    = 11
winvbe.OpenGL32  = 16425

[SourceDisksNames]
1 = %Disk%,,,

[SourceDisksFiles]
winvbe.sys   = 1
winvbe.dll   = 1
winvbecf.exe = 1
wvbgl32.dll  = 1
wvbgl32w.dll = 1
wvbglx.dll   = 1
wvbgls.dll   = 1

[Manufacturer]
%WVB% = WINVBE.Mfg,NTamd64

[WINVBE.Mfg.NTamd64]
; Per-vendor matches (PCI\VEN_xxxx&CC_0300 is a compatible id every display
; adapter of that vendor carries): Intel, AMD/ATI, nVidia and S3.  These rank
; above the bare class-code match below, so WINVBE is chosen in preference to a
; vendor driver that only puts the adapter in VGA fall-back - the Intel GMA /
; ICH integrated graphics (e.g. Samsung RV510, ICH9M) among them.
%WVB.Intel%  = winvbe, PCI\VEN_8086&CC_0300
%WVB.AMD%    = winvbe, PCI\VEN_1002&CC_0300
%WVB.NVIDIA% = winvbe, PCI\VEN_10DE&CC_0300
%WVB.S3%     = winvbe, PCI\VEN_5333&CC_0300
; and every other display adapter, by class code (VGA and 3D controllers)
%WVB.Desc% = winvbe, PCI\CC_0300
%WVB.Desc% = winvbe, PCI\CC_0001
%WVB.Desc% = winvbe, PCI\CC_0380

[winvbe]
CopyFiles = winvbe.Miniport, winvbe.Display, winvbe.Tools, winvbe.OpenGL, winvbe.OpenGL32
AddReg = winvbe.Shortcuts, winvbe.OpenGLReg

; OpenGL in software (Mesa) as the ICD of the display: the key (2000 and
; later) and the value (NT 4.0)
[winvbe.OpenGLReg]
HKLM,"Software\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers\WINVBE",Dll,,wvbgl32
HKLM,"Software\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers\WINVBE",DriverVersion,%REG_DWORD%,1
HKLM,"Software\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers\WINVBE",Flags,%REG_DWORD%,1
HKLM,"Software\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers\WINVBE",Version,%REG_DWORD%,2
HKLM,"Software\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers",WINVBE,,wvbgl32.dll
HKLM,"Software\Wow6432Node\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers\WINVBE",Dll,,wvbgl32
HKLM,"Software\Wow6432Node\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers\WINVBE",DriverVersion,%REG_DWORD%,1
HKLM,"Software\Wow6432Node\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers\WINVBE",Flags,%REG_DWORD%,1
HKLM,"Software\Wow6432Node\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers\WINVBE",Version,%REG_DWORD%,2
HKLM,"Software\Wow6432Node\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers",WINVBE,,wvbgl32.dll

; at the next logon: the Start menu folder WINVBE (Display Settings, Mouse)
[winvbe.Shortcuts]
HKLM,"Software\Microsoft\Windows\CurrentVersion\RunOnce",WINVBESETUP,,"%11%\winvbecf.exe /SETUP"

[winvbe.Miniport]
winvbe.sys

[winvbe.Display]
winvbe.dll

[winvbe.Tools]
winvbecf.exe

[winvbe.OpenGL]
wvbgl32.dll

[winvbe.OpenGL32]
wvbgl32.dll,wvbgl32w.dll
wvbglx.dll
wvbgls.dll

[winvbe.SoftwareSettings]
AddReg = winvbe_SoftwareDeviceSettings

[winvbe_SoftwareDeviceSettings]
HKR,, InstalledDisplayDrivers,      %REG_MULTI_SZ%, winvbe
HKR,, VgaCompatible,                %REG_DWORD%,    0
HKR,, DefaultSettings.BitsPerPel,   %REG_DWORD%,    16
HKR,, DefaultSettings.XResolution,  %REG_DWORD%,    1024
HKR,, DefaultSettings.YResolution,  %REG_DWORD%,    768
HKR,, DefaultSettings.VRefresh,     %REG_DWORD%,    60

[winvbe.GeneralConfigData]
MaximumDeviceMemoryConfiguration = 128

[winvbe.Services]
AddService = winvbe, 0x00000002, winvbe_Service_Inst, winvbe_EventLog_Inst

[winvbe_Service_Inst]
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 1                  ; SERVICE_SYSTEM_START
ErrorControl   = 0                  ; SERVICE_ERROR_IGNORE
LoadOrderGroup = Video
ServiceBinary  = %12%\winvbe.sys

[winvbe_EventLog_Inst]
AddReg = winvbe_EventLog_AddReg

[winvbe_EventLog_AddReg]
HKR,,EventMessageFile,0x00020000,"%SystemRoot%\System32\IoLogMsg.dll;%SystemRoot%\System32\drivers\winvbe.sys"
HKR,,TypesSupported,0x00010001,7

[Strings]
WVB          = "WINVBE"
WVB.Desc     = "WINVBE Universal VESA/VGA/SVGA"
WVB.Intel    = "WINVBE Universal VESA/VGA/SVGA (Intel)"
WVB.AMD      = "WINVBE Universal VESA/VGA/SVGA (AMD/ATI)"
WVB.NVIDIA   = "WINVBE Universal VESA/VGA/SVGA (nVidia)"
WVB.S3       = "WINVBE Universal VESA/VGA/SVGA (S3)"
Disk         = "WINVBE v1.3 for Windows NT"
REG_SZ       = 0x00000000
REG_MULTI_SZ = 0x00010000
REG_DWORD    = 0x00010001
